{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message",
  "type": "object",
  "required": ["threadId", "sender", "body"],
  "properties": {
    "threadId": { "type": "string" },
    "sender": { "type": "string" },
    "body": { "type": "string", "maxLength": 5000 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
